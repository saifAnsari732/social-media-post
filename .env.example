# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Gemini (content generation ke liye)
GEMINI_API_KEY=your_gemini_api_key_here

# ===== YouTube (Google OAuth) =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/callback/youtube

# ===== Facebook + Instagram (Meta Graph API, same App) =====
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/facebook
# Instagram business account ko Facebook Page se connect hona zaroori hai (Meta ka rule hai)

# ===== X / Twitter (OAuth 2.0) =====
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/callback/twitter

# ===== LinkedIn =====
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# ===== TikTok (Content Posting API) =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/tiktok
